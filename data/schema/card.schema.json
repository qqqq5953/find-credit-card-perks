{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Card",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "bank", "name", "source_urls", "verified", "updated_at", "reward_unit", "base", "switchable", "plans"],
  "definitions": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "rate": { "type": "number", "minimum": 0, "maximum": 0.5 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "match", "rate"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "description": { "type": "string", "minLength": 1 },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "categories": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "merchants": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "payments": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "region": { "enum": ["domestic", "overseas"] }
          }
        },
        "rate": { "$ref": "#/definitions/rate" },
        "cap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["period", "max_reward"],
          "properties": {
            "period": { "enum": ["month", "quarter", "half_year", "year", "once"] },
            "max_reward": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "conditions": { "type": "array", "items": { "type": "string" } },
        "valid_from": { "$ref": "#/definitions/date" },
        "valid_to": { "$ref": "#/definitions/date" }
      }
    }
  },
  "properties": {
    "id": { "$ref": "#/definitions/id" },
    "bank": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "image": { "type": "string" },
    "source_urls": { "type": "array", "items": { "type": "string", "pattern": "^https?://" }, "minItems": 1 },
    "verified": { "type": "boolean" },
    "updated_at": { "$ref": "#/definitions/date" },
    "valid_from": { "$ref": "#/definitions/date" },
    "valid_to": { "$ref": "#/definitions/date" },
    "reward_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "twd_value"],
      "properties": {
        "type": { "enum": ["cash", "points", "miles"] },
        "name": { "type": "string" },
        "twd_value": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domestic", "overseas"],
      "properties": {
        "domestic": { "$ref": "#/definitions/rate" },
        "overseas": { "$ref": "#/definitions/rate" }
      }
    },
    "switchable": { "type": "boolean" },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "rules"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "name": { "type": "string" },
          "rules": { "type": "array", "items": { "$ref": "#/definitions/rule" } }
        }
      }
    },
    "exclusions": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" }
  }
}
