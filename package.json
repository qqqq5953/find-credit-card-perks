{
  "name": "find-credit-card-perks",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply perks-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply perks-db --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate-cards": "tsx scripts/validate-cards.ts",
    "fetch-sources": "tsx scripts/fetch-sources.ts",
    "diff-cards": "tsx scripts/diff-cards.ts",
    "build-data": "tsx scripts/build-data.ts",
    "predev": "npm run build-data",
    "predeploy": "npm run build-data",
    "pretest": "npm run build-data",
    "pretypecheck": "npm run build-data"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unpdf": "^1.9.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
